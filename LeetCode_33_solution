class Solution(object):
    def search(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: int
        """
        n= len(nums)
        # target =int(input) 
        idx =-1
        for i in range(0,n):
            
            if nums[i]==target:
               idx=i
        return idx
